/*
 * Corne (ZMK) — раскладка для C / Rust с поддержкой русской раскладки.
 *
 * Слои:
 *   BASE   — твой базовый слой (замени три верхних ряда на свои, если отличаются)
 *   RU     — «флажок» русского режима: прозрачный, включается клавишей языка
 *   NAV    — держи левый большой: стрелки, модификаторы, Undo/Cut/Copy/Paste
 *   SYM    — держи правый большой: символы
 *   SYM_RU — то же, но для русского режима (включается автоматически)
 *   NUM    — NAV + SYM вместе: цифры, F-клавиши, Bluetooth
 *
 * Язык переключай ТОЛЬКО клавишей на клавиатуре (правый крайний большой),
 * иначе клавиатура не узнает, что язык сменился. Если вдруг рассинхрон —
 * просто нажми её 1–2 раза: она шлёт «абсолютные» хоткеи, состояние выровняется.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE   0
#define RU     1
#define NAV    2
#define SYM    3
#define SYM_RU 4
#define NUM    5

/* Хоткеи ОС «включить английский» / «включить русский».
 * Windows: Параметры → Время и язык → Ввод → Доп. параметры клавиатуры →
 *          Сочетания клавиш для языков ввода → назначь English = Ctrl+Shift+1,
 *          Русский = Ctrl+Shift+2. */

#define HK_EN LC(LS(N1))
#define HK_RU LC(LS(N2))

/* Пауза между переключением языка и символом (мс).
 * Если в русском режиме вместо символов иногда печатаются буквы — увеличь до 60–80. */

#define RU_DELAY 40

&lt {
    quick-tap-ms = <200>;   /* тап + удержание = автоповтор Tab/Backspace */
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };

        sym_ru {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    macros {
        lang_ru: lang_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_RU &tog 0>;
        };

        lang_en: lang_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &tog 0>;
        };

        /* Символы для русского режима: переключиться на EN → символ → обратно на RU.
         * Символы, которые в русской раскладке стоят там же (! % * ( ) - _ = + \),
         * шлются напрямую, без переключения. */

        ru_grave: ru_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp GRAVE &kp HK_RU>;
        };

        ru_caret: ru_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp CARET &kp HK_RU>;
        };

        ru_hash: ru_hash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp HASH &kp HK_RU>;
        };

        ru_lt: ru_lt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp LT &kp HK_RU>;
        };

        ru_gt: ru_gt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp GT &kp HK_RU>;
        };

        ru_amps: ru_amps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp AMPS &kp HK_RU>;
        };

        ru_tilde: ru_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp TILDE &kp HK_RU>;
        };

        ru_pipe: ru_pipe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp PIPE &kp HK_RU>;
        };

        ru_at: ru_at {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp AT &kp HK_RU>;
        };

        ru_lbrc: ru_lbrc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp LBRC &kp HK_RU>;
        };

        ru_rbrc: ru_rbrc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp RBRC &kp HK_RU>;
        };

        ru_dqt: ru_dqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp DQT &kp HK_RU>;
        };

        ru_dllr: ru_dllr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp DLLR &kp HK_RU>;
        };

        ru_colon: ru_colon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp COLON &kp HK_RU>;
        };

        ru_sqt: ru_sqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp SQT &kp HK_RU>;
        };

        ru_fslh: ru_fslh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp FSLH &kp HK_RU>;
        };

        ru_lbkt: ru_lbkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp LBKT &kp HK_RU>;
        };

        ru_rbkt: ru_rbkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp RBKT &kp HK_RU>;
        };

        ru_qmark: ru_qmark {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp QMARK &kp HK_RU>;
        };

        ru_semi: ru_semi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <RU_DELAY>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HK_EN &kp SEMI &kp HK_RU>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E     &kp R      &kp T        &kp Y      &kp U            &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F      &kp G        &kp H      &kp J            &kp K      &kp L    &kp SEMI  &kp SINGLE_QUOTE
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V      &kp B        &kp N      &kp M            &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                         &kp LGUI  &lt 1 TAB  &kp SPACE    &kp ENTER  &lt 2 RIGHT_ALT  &kp RCTRL
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&trans  &none      &none      &none      &none      &none        &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp DEL  &trans
&trans  &kp LGUI   &kp LALT   &kp LSHFT  &kp LCTRL  &kp CAPS     &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &none    &trans
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Y)    &trans    &trans     &trans     &none      &none    &trans
                              &trans     &trans     &trans       &trans    &trans     &trans
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
&kp GRAVE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3   &kp NUMBER_4   &kp NUMBER_5        &kp N6            &kp NUMBER_7       &kp NUMBER_8          &kp NUMBER_9           &kp NUMBER_0  &kp MINUS
&trans     &kp GRAVE     &none         &kp BACKSLASH  &kp LESS_THAN  &kp GREATER_THAN    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans        &trans
&trans     &trans        &trans        &trans         &trans         &trans              &kp PLUS          &kp MINUS          &kp UNDER             &kp EQUAL              &trans        &trans
                                       &trans         &trans         &trans              &trans            &trans             &trans
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&trans  &kp F1   &kp F2   &kp F3        &kp F4        &kp F5          &kp KP_PLUS   &kp N7  &kp N8  &kp N9  &kp KP_MULTIPLY  &trans
&trans  &kp F6   &kp F7   &kp F8        &kp F9        &kp F10         &kp KP_MINUS  &kp N4  &kp N5  &kp N6  &kp KP_DIVIDE    &trans
&trans  &kp F11  &kp F12  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &kp N0        &kp N1  &kp N2  &kp N3  &kp KP_DOT       &bt BT_CLR
                          &trans        &trans        &trans          &trans        &trans  &trans
            >;
        };
    };
};
